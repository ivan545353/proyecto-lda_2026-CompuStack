productos    ||--o{  ocl         : "se compra en"
productos    ||--o{  compl       : "se factura en"

proveedores  ||--o{  oc          : "recibe"
oc           ||--|{  ocl         : "detalla"

carritos     ||--|{  cl          : "contiene"
carritos     ||--o|  ventas      : "se convierte en"

ventas       ||--|{  vl          : "detalla"
ventas       ||--o{  pagos       : "se cobra con"
ventas       ||--o{  comp        : "se factura con"
ventas       ||--o|  envios      : "se despacha con"
