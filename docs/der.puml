users        ||--o|  clientes    : "si ambito = tienda"
users        ||--o|  empleados   : "si ambito = gestion"
users        ||--o{  ventas      : "vende (mostrador)"
users        ||--o{  pagos       : "cobra"
users        ||--o{  movimientos : "registra"
users        ||--o{  carritos    : "posee"
users        ||--o{  oc          : "crea / aprueba"

clientes     ||--o{  direcciones : "tiene"
clientes     ||--o{  ventas      : "compra"

categorias   ||--o{  categorias  : "padre de"
