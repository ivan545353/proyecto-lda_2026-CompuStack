# Colección de peticiones de la Etapa 3: demostrar la API sin depender de las interfaces.
# Formato `.http` (REST Client de VS Code, cliente HTTP de JetBrains): texto plano, sin librerías.
# Cada tramo agrega las suyas en su bloque. Contraseña: la de `PersonasDemoSeeder`.

@base = http://localhost:8000/api/v1

### ── Tramo B — Sesión común ───────────────────────────────────────────────

# Una cuenta de gestión inicia sesión por el mismo endpoint que la app (vence en 8 h).
# @name sesionGestion
POST {{base}}/sesion
Accept: application/json
Content-Type: application/json

{ "email": "vendedor@sistema.local", "password": "demo1234" }

###

# Una cuenta de la tienda, por el mismo endpoint (vence en 7 días).
# @name sesionTienda
POST {{base}}/sesion
Accept: application/json
Content-Type: application/json

{ "email": "cliente@sistema.local", "password": "demo1234" }

###

# Quién soy: rol y permisos de gestión.
GET {{base}}/yo
Accept: application/json
Authorization: Bearer {{sesionGestion.response.body.datos.credencial}}

###

# Quién soy: rol y permisos de la tienda.
GET {{base}}/yo
Accept: application/json
Authorization: Bearer {{sesionTienda.response.body.datos.credencial}}

###

# Sin credencial: 401 sin_sesion.
GET {{base}}/yo
Accept: application/json

###

# Cerrar la sesión de gestión: 204. Repetir el GET /yo de gestión da 401 sesion_invalida.
DELETE {{base}}/sesion
Accept: application/json
Authorization: Bearer {{sesionGestion.response.body.datos.credencial}}

###

# Límite de intentos: la sexta en un minuto da 429 demasiados_intentos con reintentar_en.
POST {{base}}/sesion
Accept: application/json
Content-Type: application/json

{ "email": "vendedor@sistema.local", "password": "equivocada1" }

###

### ── Tramo C — La administración, cliente de la API ─────────────────────────

# El formulario de ingreso de la administración hace esta misma petición (módulo central).
# La credencial queda en la cookie `credencial`, y la navegación la manda para servir las pantallas.
# @name sesionAdmin
POST {{base}}/sesion
Accept: application/json
Content-Type: application/json

{ "email": "vendedor@sistema.local", "password": "demo1234" }

###

# La API no acepta la cookie: sin `Authorization`, 401 sin_sesion aunque el navegador la mande.
GET {{base}}/yo
Accept: application/json
Cookie: credencial={{sesionAdmin.response.body.datos.credencial}}

###

# Con Bearer, sí. `rol.ambito` = gestion: el formulario sólo deja seguir a esas cuentas.
GET {{base}}/yo
Accept: application/json
Authorization: Bearer {{sesionAdmin.response.body.datos.credencial}}

###

# La pantalla también la lee de la cookie: sin permiso panel.ver_global, el panel general da 403.
GET http://localhost:8000/panel/general
Accept: text/html
Cookie: credencial={{sesionAdmin.response.body.datos.credencial}}

###

# Salir desde la administración: 204. Después, la cookie ya no abre ninguna pantalla.
DELETE {{base}}/sesion
Accept: application/json
Authorization: Bearer {{sesionAdmin.response.body.datos.credencial}}

###

### ── Tramo D — El catálogo, un recurso para los dos clientes ───────────────────

# La frase de la etapa: modificar un producto desde la administración y verlo desde el teléfono,
# por el mismo endpoint y con la misma credencial. El administrativo edita; el cliente lo ve.
# @name sesionAdministrativo
POST {{base}}/sesion
Accept: application/json
Content-Type: application/json

{ "email": "administrativo@sistema.local", "password": "demo1234" }

###

# El listado de gestión: otra representación del mismo recurso que la tienda (regla 36). Con
# precio.ver_costo viajan costo_promedio y margen; con stock.ver, stock y stock_reservado.
GET {{base}}/productos?forma=gestion&q=VG248&estado=activos
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# La ficha de gestión: el cálculo del precio y los últimos cambios, por permiso.
GET {{base}}/productos/1?forma=gestion
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# La misma forma pedida por una cuenta de tienda: 403 sin_permiso. Sin credencial: 401 sin_sesion.
GET {{base}}/productos?forma=gestion
Accept: application/json
Authorization: Bearer {{sesionTienda.response.body.datos.credencial}}

###

# El administrativo cambia el precio (con precio_manual, el precio lo pone él).
PATCH {{base}}/productos/1
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

{
  "codigo": "VG248QG", "nombre": "Monitor ASUS VG248QG 165Hz", "categoria_id": 11, "marca_id": 1,
  "precio_manual": true, "precio_contado": "489.000,00", "precio_lista": "586.800,00",
  "alicuota_iva": "21.00", "stock_minimo": 2, "cantidad_reposicion": 5, "activo": true
}

###

# Y el teléfono lo ve: la ficha de la tienda, sin forma, con la credencial del cliente. Mismo recurso.
GET {{base}}/productos/1
Accept: application/json
Authorization: Bearer {{sesionTienda.response.body.datos.credencial}}

###

# La validación rechaza, no corrige: sin `activo` ni `precio_manual`, 422 (la API no adivina una casilla).
POST {{base}}/productos
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

{ "codigo": "DEMO-1", "nombre": "Producto de prueba", "categoria_id": 11, "alicuota_iva": "21.00" }

###

# Sin el permiso de la acción, 403: el vendedor ve el catálogo pero no lo da de alta.
POST {{base}}/productos
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{sesionGestion.response.body.datos.credencial}}

{}

###

# Recalcular el precio desde el costo: con precio manual, dice que quedó como estaba.
POST {{base}}/productos/1/recalcular
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# El comparador de proveedores del producto: por costo, el más barato y cuánto más caro es cada uno.
GET {{base}}/productos/1/proveedores?forma=comparador
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# A quién pedirle (lo usa el armador de compras): el elegido primero; el costo, sólo con su permiso.
GET {{base}}/productos/1/proveedores
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# La impresión: el endpoint valida y devuelve una URL firmada de cinco minutos (D-22). El navegador
# la abre sin credencial; vencida o tocada, 403.
GET {{base}}/productos/impresion?formato=pdf&stock=critico
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# Una columna que pide un permiso que no se tiene es 422, no una columna vacía.
GET {{base}}/productos/impresion?formato=pdf&columnas[]=costo
Accept: application/json
Authorization: Bearer {{sesionGestion.response.body.datos.credencial}}

###

# Categorías: el árbol de la tienda no cambia con quién mira. Con una credencial que no sirve, el
# árbol igual (credencial si sirve); la lista de gestión pide categoria.ver.
GET {{base}}/categorias
Accept: application/json
Authorization: Bearer inventada

###

GET {{base}}/categorias?forma=lista&parent_id=raiz
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# Marcas: la baja de una marca con productos no borra, desactiva (regla 2), y el mensaje lo dice.
GET {{base}}/marcas?estado=activas
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# El buscador de la venta es el listado de clientes, con `q`.
GET {{base}}/clientes?q=tilos
Accept: application/json
Authorization: Bearer {{sesionGestion.response.body.datos.credencial}}

###

### ── Tramo E — Terceros: clientes, direcciones y proveedores ─────────────

# Clientes: el listado con sus filtros. `cuenta` distingue al cliente de mostrador del que tiene cuenta
# de la tienda; cada fila trae las claves de siempre y las nuevas al final.
GET {{base}}/clientes?cuenta=sin_cuenta&condicion_iva=consumidor_final
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# El alta: 201 con el cliente y el aviso. La misma fila que devuelve el listado (la usa el alta rápida de la venta).
# @name altaCliente
POST {{base}}/clientes
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

{
  "razon_social": "Kiosco La Esquina",
  "condicion_iva": "consumidor_final",
  "tipo_doc": "dni",
  "nro_doc": "30111222",
  "email": "esquina@ejemplo.com",
  "telefono": "2974111222"
}

###

# La ficha trae las direcciones (no hay GET de una sola): la predeterminada primero.
GET {{base}}/clientes/{{altaCliente.response.body.datos.id}}
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# Una dirección: se busca dentro del cliente (la de otro cliente es 404). La primera queda predeterminada.
# @name altaDireccion
POST {{base}}/clientes/{{altaCliente.response.body.datos.id}}/direcciones
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

{
  "calle": "Av. Eva Perón",
  "numero": "1450",
  "piso_depto": null,
  "codigo_postal": "9011",
  "localidad": "Caleta Olivia",
  "provincia": "Santa Cruz",
  "es_predeterminada": true
}

###

# La validación rechaza, no corrige (M-31): una casilla ausente es 422, no «no».
POST {{base}}/clientes/{{altaCliente.response.body.datos.id}}/direcciones
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

{ "calle": "Mitre", "numero": "10", "codigo_postal": "9011", "localidad": "Caleta Olivia", "provincia": "Santa Cruz" }

###

# El acceso a la tienda: devuelve el enlace de un solo uso, sólo en esta respuesta y sin caché (HL-114).
# Con la cuenta ya creada, o sin correo, es 409.
POST {{base}}/clientes/{{altaCliente.response.body.datos.id}}/acceso-tienda
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

{ "nombre": "Lucía", "apellido": "Esquina" }

###

# Proveedores: el listado con el canal de pedido y los conteos que hace la base.
GET {{base}}/proveedores?canal=email&estado=activos
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# El alta de un proveedor por el canal del portal: la dirección del portal es obligatoria sólo ahí.
# @name altaProveedor
POST {{base}}/proveedores
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

{
  "razon_social": "Mayorista del Sur S.R.L.",
  "cuit": "30-71111111-4",
  "email": "ventas@mayoristadelsur.com.ar",
  "telefono": "2974000111",
  "contacto": "Mesa de pedidos",
  "canal_pedido": "portal_externo",
  "portal_url": "https://pedidos.mayoristadelsur.com.ar",
  "plazo_entrega_dias": 3,
  "activo": true
}

###

# La ficha trae `productos_activos`: lo que la desactivación con cascada va a alcanzar.
GET {{base}}/proveedores/{{altaProveedor.response.body.datos.id}}
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# Un proveedor referenciado no se borra: se desactiva (regla 2) y el mensaje lo dice.
DELETE {{base}}/proveedores/{{altaProveedor.response.body.datos.id}}
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# La impresión de los dos listados, por URL firmada (D-22).
GET {{base}}/clientes/impresion?formato=csv
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

GET {{base}}/proveedores/impresion?formato=pdf
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

### ── Tramo F — Precios y stock ──────────────────────────────────────────────

# Cambiar cinco mil precios es del Administrador (tramo D). Su contraseña no es la de demostración:
# es la de `ADMIN_PASSWORD` en tu `.env`. Ponela acá sólo en tu copia local, nunca en el repositorio.
@claveAdministrador = la-de-tu-env

# @name sesionAdministrador
POST {{base}}/sesion
Accept: application/json
Content-Type: application/json

{ "email": "admin@sistema.local", "password": "{{claveAdministrador}}" }

###

# La parametrización: la política vigente, los impuestos (cada alícuota cuenta los productos que la
# usan, lo cuenta la base) y los factores de costo.
GET {{base}}/precios/politica
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

GET {{base}}/impuestos
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# Qué precio daría un costo, sin escribir nada. Sin `ganancia`, la global; el `calculo` es el mismo de
# la ficha de gestión de un producto.
GET {{base}}/precios/simulacion?costo=20000&alicuota_iva=21.00
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# La validación rechaza, no corrige (M-31): la política sin redondeo es 422.
PATCH {{base}}/precios/politica
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{sesionAdministrador.response.body.datos.credencial}}

{ "ganancia_global": "2,5", "recargo_lista": "0" }

###

# El ajuste masivo, primero mirado: los conteos del conjunto entero y una página de «precio actual →
# nuevo». No escribe nada. Sin precio.ver_costo, las claves `costo` y `costo_nuevo` no viajan.
GET {{base}}/precios/ajustes/vista-previa?operacion=precio&porcentaje=5&alcance=todos&incluir_manuales=0
Accept: application/json
Authorization: Bearer {{sesionAdministrador.response.body.datos.credencial}}

###

# Y después aplicado: 201 con el lote y su criterio congelado como texto.
# Si no alcanza a ningún producto, 409 regla_de_negocio: no se escribió nada (HL-122).
# @name ajusteMasivo
POST {{base}}/precios/ajustes
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{sesionAdministrador.response.body.datos.credencial}}

{ "operacion": "precio", "porcentaje": "5", "alcance": "todos", "incluir_manuales": false }

###

# El historial dice cuál es el único lote que se puede deshacer (`reversible`, en el sobre y en su fila).
GET {{base}}/precios/lotes
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# Deshacer escribe un lote nuevo que devuelve los precios (M-16). El administrativo no puede: 403.
POST {{base}}/precios/lotes/{{ajusteMasivo.response.body.datos.id}}/deshacer
Accept: application/json
Authorization: Bearer {{sesionAdministrador.response.body.datos.credencial}}

###

# El kardex, del más nuevo al más viejo y de a 20. Un rango de fechas al revés es 422 (HL-120).
GET {{base}}/stock/movimientos?tipo=compra
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# El stock de un producto y dónde está lo reservado: pedidos de la tienda sin cobrar y compras que se
# están confirmando (D-25). Es la referencia que el ajuste manda en `stock_esperado`.
GET {{base}}/productos/1/stock
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# El ajuste por conteo: se carga lo contado, no la diferencia. Si `stock_esperado` ya no es el de la
# base, alguien movió el stock mientras se contaba: 409, sin pisar ese movimiento.
POST {{base}}/productos/1/ajustes-stock
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

{ "stock_contado": 8, "stock_esperado": 10, "motivo": "Dos unidades con la caja rota" }

###

# La impresión del kardex, por URL firmada (D-22), con los filtros puestos y sin la página.
GET {{base}}/stock/movimientos/impresion?formato=csv&tipo=ajuste
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

### ── Tramo G — Compras ──────────────────────────────────────────────────────

# Qué hay que reponer, agrupado por proveedor. El costo y los estimados viajan sólo con
# `precio.ver_costo` (el Administrativo lo tiene); sin él, las claves no están.
GET {{base}}/compras/sugeridos
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# Los sugeridos elegidos, como renglones del armador. Lo que dejó de hacer falta no entra: `descartados`.
GET {{base}}/compras/armador?productos[]=1
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# El armador guarda un borrador por proveedor (201). Un producto que ese proveedor no provee es 422.
# @name pedidoCompra
POST {{base}}/compras
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

{ "lineas": [ { "producto_id": 1, "proveedor_id": 1, "cantidad_pedida": 10, "costo_unitario": "2500,00" } ] }

###

# La ficha: proveedor, líneas, recepciones y `acciones`, que dice qué admite el estado.
# @name fichaCompra
GET {{base}}/compras/{{pedidoCompra.response.body.datos.0.id}}
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# El PDF de un borrador no existe: 409. El pedido se imprime cuando alguien autoriza el gasto.
GET {{base}}/compras/{{pedidoCompra.response.body.datos.0.id}}/pdf
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# Aprobar compromete el monto y congela las líneas. Después, editar es 409.
POST {{base}}/compras/{{pedidoCompra.response.body.datos.0.id}}/aprobar
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# Recibir parte: entra stock por StockService, y el asiento sale en el kardex con su remito (201).
POST {{base}}/compras/{{pedidoCompra.response.body.datos.0.id}}/recepciones
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

{ "cantidades": { "{{fichaCompra.response.body.datos.lineas.0.id}}": 4 }, "remito_numero": "0001-00001234", "remito_fecha": "2026-11-21" }

###

# Ahora sí: el enlace firmado del pedido, para abrirlo sin la credencial (D-22).
GET {{base}}/compras/{{pedidoCompra.response.body.datos.0.id}}/pdf
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}

###

# El listado, con sus filtros: las abiertas de ese proveedor.
GET {{base}}/compras?estado=abiertas&proveedor_id=1
Accept: application/json
Authorization: Bearer {{sesionAdministrativo.response.body.datos.credencial}}
